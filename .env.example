# Token from @BotFather (Telegram)
TELEGRAM_BOT_TOKEN=

# Optional: comma-separated Telegram user ids allowed to use the bot.
# Leave empty to allow everyone (fine for first tests, then lock it down).
# /start replies with your id.
ALLOWED_USER_IDS=

# Optional: where the SQLite database file lives (default: data/lifelog.db)
DATABASE_PATH=

# OpenRouter key from https://openrouter.ai/keys — without it the bot runs
# in echo mode (no AI understanding).
OPENROUTER_API_KEY=

# Any OpenRouter model id, e.g. anthropic/claude-sonnet-4.5 or
# google/gemini-2.5-flash (default: openai/gpt-4o-mini)
OPENROUTER_MODEL=
