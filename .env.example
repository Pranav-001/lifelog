# Token from @BotFather (Telegram)
TELEGRAM_BOT_TOKEN=

# Optional: comma-separated Telegram user ids allowed to use the bot.
# Leave empty to allow everyone (fine for first tests, then lock it down).
# /start replies with your id.
ALLOWED_USER_IDS=

# Optional: where the SQLite database file lives (default: data/lifelog.db)
DATABASE_PATH=
